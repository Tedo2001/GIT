# --- Exchange ---
# MARKET_TYPE: FUTURES or SPOT
MARKET_TYPE=FUTURES

# ENVIRONMENT: DEMO or LIVE
# DEMO is the safe default. Futures demo uses demo-fapi.binance.com.
ENVIRONMENT=DEMO

BINANCE_API_KEY=
BINANCE_API_SECRET=

# LIVE trading requires this exact opt-in value.
# Leave blank for DEMO.
LIVE_TRADING_CONFIRM=

# --- Strategy ---
SYMBOL=BTCUSDT
BAR_SIZE=1h
HORIZON=37
THRESHOLD_MULTIPLIER=1.0
ALLOW_SHORTS=true

# Target notional = EQUITY * RISK_PER_TRADE * LEVERAGE
# This is NOT stop-loss risk.
EQUITY=10000
RISK_PER_TRADE=0.10
LEVERAGE=1.0

TAKER_FEE_RATE=0.0010
SLIPPAGE_RATE=0.0005

# How much historical data to request each cycle.
DATA_LIMIT=1000

# Seconds to wait after a candle boundary before checking.
CLOSE_GRACE_SECONDS=5

# State file
STATE_FILE=data/state.json

# If true, bot places no orders even in LIVE mode.
DRY_RUN=false
