# Coinbase Global Derivatives / perpetuals
MARKET_TYPE=GLOBAL_DERIVATIVES
ENVIRONMENT=LIVE

# Preferred: point this to the JSON file downloaded by Coinbase CDP.
# Keep the JSON outside this repository.
COINBASE_KEY_FILE=

# Alternative to COINBASE_KEY_FILE:
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

INSTRUMENT=BTC_USDC-PERPETUAL
CURRENCY=USDC
INTERVAL=1h
HORIZON=37
DATA_LIMIT=1000

THRESHOLD_MULTIPLIER=1.0
TAKER_FEE_RATE_FALLBACK=0.0005
SLIPPAGE_RATE=0.0005
MARKET_ORDER_SLIPPAGE=0.003

ALLOW_SHORTS=true
POSITION_FRACTION=0.10
MAX_POSITION_FRACTION=0.25
MAX_LEVERAGE_CAP=3.0
MAX_DAILY_LOSS_PCT=0.05
MIN_ACCOUNT_VALUE_USDC=10.0

DRY_RUN=true
LIVE_TRADING_CONFIRM=

POLL_SECONDS=15
CLOSE_GRACE_SECONDS=8
REQUEST_TIMEOUT=15

STATE_FILE=data/state.json
TRADE_LOG_FILE=logs/trades.jsonl
